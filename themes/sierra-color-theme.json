  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6C665C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.logical",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C1440E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7D5F3C"
      }
    },
    {
      "name": "Functions & methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#8A6020"
      }
    },
    {
      "name": "Classes & types",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#7A4A1E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#3E2B1A"
      }
    },
    {
      "name": "Instance variables / self",
      "scope": [
        "variable.other.readwrite.instance",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#C1440E"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#A0522D"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#A0522D"
      }
    },
    {
      "name": "Symbols & special literals (Ruby)",
      "scope": [
        "constant.other.symbol",
        "support.literal.symbol"
      ],
      "settings": {
        "foreground": "#8A6020"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#806249"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8F7258"
      }
    },
    {
      "name": "Tags (HTML/ERB)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C1440E"
      }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#8A6020"
      }
    },
    {
      "name": "Interpolation (#{…})",
      "scope": [
        "punctuation.section.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#C1440E"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#81633D"
      }
    },
    {
      "name": "Invalid / deprecated",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": {
        "foreground": "#C1440E",
        "fontStyle": "strikethrough"
      }
    }
  ],

  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable.defaultLibrary": "#A0522D",
    "function": "#8A6020",
    "method": "#8A6020",
    "class": { "foreground": "#7A4A1E", "bold": true },
    "parameter": "#5A3520",
    "property": "#8B5F2A"
  }
}
